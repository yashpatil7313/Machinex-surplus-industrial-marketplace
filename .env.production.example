# MACHINEX Production Environment Variables Template
NODE_ENV=production
PORT=5000
JWT_SECRET=replace_with_a_secure_random_string_in_production

# Optional: Dedicated MySQL Database (If left empty, MACHINEX automatically runs on its high-performance embedded SQL engine)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=machinex_db
DB_PORT=3306
