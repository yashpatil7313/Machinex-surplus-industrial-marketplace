# MACHINEX Production Environment Variables Template
NODE_ENV=production
PORT=5000
JWT_SECRET=replace_with_a_secure_random_string_in_production

# Option 1: PostgreSQL Connection String (Recommended for Render, Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@host:5432/machinex_db

# Option 2: Individual PostgreSQL / MySQL Parameters (Optional if DATABASE_URL is set)
DB_ENGINE=postgres
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=machinex_db
DB_PORT=5432
