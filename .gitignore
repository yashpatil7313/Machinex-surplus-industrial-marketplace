# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production Build Output (generated by npm run build)
frontend/dist/

# Local Environment Variables
.env
backend/.env
frontend/.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# SQLite local runtime file (auto-generated & auto-seeded if missing)
backend/machinex_local.db

# Ensure high-res product photos are tracked
!backend/uploads/*.jpg
!frontend/public/uploads/*.jpg
